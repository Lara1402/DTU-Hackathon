# MoodUI Studio — Environment Configuration
# Copy this file to .env or server/.env

# Port for backend API server
PORT=3001

# Google AI / Gemma 4 API Key (Optional)
# Leave blank to run in Local High-Fidelity Engine mode
GEMMA_API_KEY=

# Target Gemma / Gemini Model
# Supported options: gemma-2-9b-it, gemma-2-27b-it, gemini-2.5-flash, gemini-1.5-flash
GEMMA_MODEL=gemma-2-9b-it

# Optional custom serving endpoint (defaults to Google AI API)
# GEMMA_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
